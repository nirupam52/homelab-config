# sshd for the hermes-sandbox container. Runs unprivileged as `agent` on a
# high port, so the only account it can ever authenticate is `agent`.
Port 2222
HostKey /home/agent/.sshd/ssh_host_ed25519_key
PidFile none
AuthorizedKeysFile /etc/hermes-ssh/authorized_keys
AllowUsers agent
StrictModes no
UsePAM no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
PermitUserEnvironment no
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
MaxAuthTries 3
ClientAliveInterval 30
ClientAliveCountMax 4
LogLevel INFO
